{
  "manifest_version": 3,
  "name": "AuditLens — CRO, SEO & Speed Audits",
  "short_name": "AuditLens",
  "version": "0.3.0",
  "description": "Audit any page for conversion, SEO and speed problems, see a predicted attention heatmap, and export a client-ready report with clear fixes.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AuditLens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs", "identity"],
  "host_permissions": ["<all_urls>"]
}
